# Copy to .env (git-ignored) and fill in. NEVER commit real credentials.
# Copernicus Data Space Ecosystem account (free): https://dataspace.copernicus.eu
# Needed only for the cdse_snap Sentinel-1 backend and for Sentinel-2 band downloads.
CDSE_USERNAME=
CDSE_PASSWORD=
# Path to ESA SNAP's gpt executable if it is not on PATH (cdse_snap backend only)
# SNAP_GPT=C:\Program Files\esa-snap\bin\gpt.exe
